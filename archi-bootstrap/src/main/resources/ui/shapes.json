{
  "$comment": [
    "Общая геометрия фигур: её читают канва и серверный писатель SVG, второй копии нет.",
    "Ключ — xsi:type объекта. Тип без записи рисуется записью fallback: силуэт заглушки с настоящим именем.",
    "Координаты — от левого верхнего угла фигуры в единицах SVG (1 = 1 px при 100 %).",
    "Отрицательные x и y отсчитываются от правого и нижнего края; width и height меньше либо равные нулю — размер фигуры минус модуль значения.",
    "outline — имя примитива из primitives; радиус берётся из токена radius_token файла design-tokens.yaml.",
    "layer — ключ слоя токенов; null — слой самого элемента; group, note и junction — токены холста group_*, note_* и цвет связей.",
    "label_box null — у фигуры нет подписи; corner_icon null — нет иконки."
  ],
  "version": 1,
  "default_size": {
    "width": 120,
    "height": 55
  },
  "default_size_by_type": {
    "archimate:Group": {
      "width": 400,
      "height": 140
    },
    "archimate:Note": {
      "width": 185,
      "height": 80
    },
    "archimate:Junction": {
      "width": 15,
      "height": 15
    }
  },
  "primitives": {
    "rect": "прямоугольник со скруглением радиус-токена",
    "stadium": "прямоугольник со скруглением в половину высоты",
    "circle": "круг, вписанный в фигуру",
    "tab": "прямоугольник с ярлыком слева сверху: ярлык шириной в треть фигуры, не шире 120, высотой 18",
    "dog-ear": "прямоугольник с загнутым правым верхним углом 12×12",
    "stub": "прямоугольник со скруглением радиус-токена и пунктирной обводкой",
    "bevel": "прямоугольник со срезанными углами 8×8"
  },
