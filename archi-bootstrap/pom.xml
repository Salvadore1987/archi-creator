<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uz.salvadore.hamkorbank</groupId>
        <artifactId>archi-creator</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>archi-bootstrap</artifactId>

    <name>Archi Creator :: Bootstrap</name>
    <description>
        Единственный исполняемый модуль: собирает все контексты в одно приложение,
        держит конфигурацию Spring Boot, безопасность (Keycloak/OIDC), миграции
        Flyway и — когда появится фронтенд — собранную статику.

        Здесь же живёт пакет security: ресурс-сервер и роли из токена.
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-application</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-application</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-application</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-adapter-persistence</artifactId>
        </dependency>

        <!--
            Actuator и реестр Prometheus: /actuator/health, /actuator/metrics,
            /actuator/prometheus. Список выставленных
            наружу точек закрыт в application.yaml.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Клиент Anthropic API для помощника. Только здесь: адаптер реализует порт
            LlmPort из archi-advisor-application, а ключ API живёт на сервере.
        -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
        </dependency>
        <!-- Предохранитель на Anthropic API и его состояние в метриках. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>

        <!--
            Экспорт картинок: Batik растеризует SVG в PNG (порт Rasterizer), fontbox
            вырезает из шрифта подмножество глифов для вшивания в SVG (порт Typesetter).
            Обе библиотеки в JVM, нативных зависимостей в образ не тянут.
        -->
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-transcoder</artifactId>
            <exclusions>
                <!-- Интерфейсы XML этого архива есть в JDK; вторая копия на classpath конфликтует. -->
                <exclusion>
                    <groupId>xml-apis</groupId>
                    <artifactId>xml-apis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>fontbox</artifactId>
        </dependency>
        <!--
            Выгрузка в Git: JGit без внешнего бинарника git — одна зависимость, работает
            в контейнере как есть. Адаптер порта GitRepositoryPort живёт здесь, как Batik.
        -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            spring-boot-flyway — автоконфигурация, а не библиотека. В Spring Boot 4
            автоконфигурации разъехались по отдельным модулям, и одного flyway-core
            больше не хватает: миграции лежат, приложение стартует, схема пустая.
            Отказа при этом нет — поэтому зависимость подписана.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Правила архитектуры проверяются здесь, потому что только сюда
            приходят все двенадцать модулей разом: изоляцию контекстов
            видно лишь тому, кто видит их всех.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Интеграционные тесты: контекст целиком на настоящем postgres:16
            в Testcontainers — тот же образ, что в docker-compose.yml.
            Классы *IT гоняет failsafe на фазе verify; Docker обязателен.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Jar называется archi-creator-<версия>.jar. Имя сохранено,
            каталог стал archi-bootstrap/target/ — это учитывается
            в docker-compose.yml и в CI, когда они появятся.
        -->
        <finalName>archi-creator-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
                Токены стиля живут в спецификации, и серверный писатель SVG
                читает тот же файл, что и сборка фронтенда: копия в ресурсах
                разошлась бы с ним при первой правке.
            -->
            <resource>
                <directory>${project.basedir}/../spec/ui</directory>
                <targetPath>ui</targetPath>
                <includes>
                    <include>design-tokens.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!--
                Метаданные настроек archi.* для IDE и проверки ключей: процессор пишет
                META-INF/spring-configuration-metadata.json. JDK 25 не находит процессоры
                в classpath сам — путь задаётся явно.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- После repackage классы лежат в BOOT-INF/ внутри jar, и failsafe
                         их там не видит: тесты берут классы из target/classes. -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
            <!--
                Общий отчёт покрытия: классы всех модулей реактора, данные юнит-
                и интеграционных тестов. Пороги проверяет tools/check-coverage.py
                по target/site/jacoco-aggregate/jacoco.xml: цель check видит
                только классы своего модуля, а адаптеры покрывают тесты этого.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <includeCurrentProject>true</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <!-- Версия и время сборки — в /actuator/info: какой образ запущен. -->
                            <goal>build-info</goal>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Бэкенд журнала один — Logback из стартера Spring Boot. Второй на classpath
                SLF4J не отвергает: печатает предупреждение и молча берёт один из двух.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>single-logging-backend</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.apache.logging.log4j:log4j-core</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-log4j2</exclude>
                                    </excludes>
                                    <message>
                                        Журнал пишет Logback со встроенным форматом ECS (ADR-0025):
                                        второй бэкенд SLF4J выбрал бы один из двух молча.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Сборка фронтенда: npm ci && npm run build, результат —
            target/classes/static, откуда его запекает в jar Spring Boot.

            Профиль включён по умолчанию и выключается `-P '!frontend'`: правка,
            не задевающая интерфейс, не должна требовать Node. Выключать его
            в CI нельзя — иначе jar уедет без статики и это выяснится в бою.
        -->
        <profile>
            <id>frontend</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <configuration>
                            <workingDirectory>src/main/frontend</workingDirectory>
                            <!-- Вне target/: иначе `mvn clean` каждый раз выбрасывал бы
                                 Node и качал его заново. Каталог в .gitignore. -->
                            <installDirectory>${project.basedir}/.node</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                                <configuration>
                                    <nodeVersion>${node.version}</nodeVersion>
                                    <npmVersion>${npm.version}</npmVersion>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-ci</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <!-- ci, а не install: package-lock.json — закон,
                                         а не пожелание, и сборка его не переписывает. -->
                                    <arguments>ci --no-audit --no-fund</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Юнит-тесты интерфейса: история правок, дерево, маршрутизация
                                     связей и статические проверки токенов и строк. -->
                                <id>npm-test</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>test</arguments>
                                    <skip>${skipTests}</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
