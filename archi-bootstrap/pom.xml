<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uz.salvadore.hamkorbank</groupId>
        <artifactId>archi-creator</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>archi-bootstrap</artifactId>

    <name>Archi Creator :: Bootstrap</name>
    <description>
        Единственный исполняемый модуль: собирает все контексты в одно приложение,
        держит конфигурацию Spring Boot, безопасность (Keycloak/OIDC), миграции
        Flyway и — когда появится фронтенд — собранную статику.

        Здесь же живёт то, что по §3.3 называлось пакетом security.
        NFR по контекстам — spec/nfr/.
    </description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-application</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-modeling-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-application</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-interchange-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-application</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>archi-advisor-adapter-persistence</artifactId>
        </dependency>

        <!--
            Actuator и реестр Prometheus: /actuator/health, /actuator/metrics,
            /actuator/prometheus (docs/backend.md §8.4). Список выставленных
            наружу точек закрыт в application.yaml.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            spring-boot-flyway — автоконфигурация, а не библиотека. В Spring Boot 4
            автоконфигурации разъехались по отдельным модулям, и одного flyway-core
            больше не хватает: миграции лежат, приложение стартует, схема пустая.
            Отказа при этом нет — поэтому зависимость подписана.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Правила архитектуры проверяются здесь, потому что только сюда
            приходят все двенадцать модулей разом: изоляцию контекстов
            видно лишь тому, кто видит их всех.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Интеграционные тесты (§9.3): контекст целиком на настоящем postgres:16
            в Testcontainers — тот же образ, что в docker-compose.yml (§10.1).
            Классы *IT гоняет failsafe на фазе verify; Docker обязателен.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            §10.2 обещает имя archi-creator-<версия>.jar. Имя сохранено,
            каталог стал archi-bootstrap/target/ — это учитывается
            в docker-compose.yml и в CI, когда они появятся.
        -->
        <finalName>archi-creator-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- После repackage классы лежат в BOOT-INF/ внутри jar, и failsafe
                         их там не видит: тесты берут классы из target/classes. -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Сборка фронтенда (ADR-0016): npm ci && npm run build, результат —
            target/classes/static, откуда его запекает в jar Spring Boot (§10.2).

            Профиль включён по умолчанию и выключается `-P '!frontend'`: правка,
            не задевающая интерфейс, не должна требовать Node. Выключать его
            в CI нельзя — иначе jar уедет без статики и это выяснится в бою.
        -->
        <profile>
            <id>frontend</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <configuration>
                            <workingDirectory>src/main/frontend</workingDirectory>
                            <!-- Вне target/: иначе `mvn clean` каждый раз выбрасывал бы
                                 Node и качал его заново. Каталог в .gitignore. -->
                            <installDirectory>${project.basedir}/.node</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                                <configuration>
                                    <nodeVersion>${node.version}</nodeVersion>
                                    <npmVersion>${npm.version}</npmVersion>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-ci</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <!-- ci, а не install: package-lock.json — закон,
                                         а не пожелание, и сборка его не переписывает. -->
                                    <arguments>ci --no-audit --no-fund</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
