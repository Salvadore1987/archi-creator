# Стиль исходников. Значения повторяют то, как код уже написан: правка
# по этому файлу не должна давать дифф в нетронутых строках.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,sql,py}]
indent_size = 4

[*.{ts,tsx,css,json,yaml,yml}]
indent_size = 2

# Эталоны и фикстуры — данные, сверяемые побайтово: редактор не трогает
# в них ни отступов, ни перевода строки в конце.
[{*.archimate,**/fixtures/**,**/visual/export-parity/**,**/*-snapshots/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
