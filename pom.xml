<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>uz.salvadore.hamkorbank</groupId>
    <artifactId>archi-creator</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Archi Creator</name>
    <description>
        Редактор архитектурных моделей ArchiMate. Раскладка модулей — по ADR-0001
        (spec/adr/0001-maven-multi-module.md): слой и bounded context = модуль.
        Граница «домен не знает о фреймворке» держится сборкой: у доменных модулей
        нет ни Spring, ни JPA, поэтому нарушение не компилируется.
    </description>

    <modules>
        <module>archi-modeling</module>
        <module>archi-interchange</module>
        <module>archi-advisor</module>
        <module>archi-bootstrap</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>

        <!--
            Node и npm ставит сборка, а не разработчик: иначе версия
            зависит от машины, а фронтенд собирается по-разному в CI
            и локально. v24 — действующий LTS.
        -->
        <node.version>v24.21.0</node.version>
        <npm.version>11.19.0</npm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Импорт BOM фиксирует версии, но не добавляет ничего на classpath:
                доменные модули остаются чистыми, версии Spring, Flyway, драйвера
                PostgreSQL и JUnit в модулях не пинятся.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Тестовый стек доступен всем модулям; Spring сюда не попадает. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>

                <!--
                    ADR-0001: граница домена держится сборкой. Отсутствия зависимости
                    достаточно, пока её никто не вернул, — это правило останавливает
                    возврат. Подключается в модулях domain и application; объявить
                    плагин достаточно, конфигурация приходит отсюда.

                    Осознанно НЕ включено в родительский build/plugins: иначе правило
                    унаследовали бы и адаптеры, которым Spring нужен.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>ban-framework</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <bannedDependencies>
                                        <searchTransitive>true</searchTransitive>
                                        <excludes>
                                            <exclude>org.springframework*:*</exclude>
                                            <exclude>jakarta.persistence:*</exclude>
                                            <exclude>jakarta.transaction:*</exclude>
                                            <exclude>org.hibernate*:*</exclude>
                                        </excludes>
                                        <message>
                                            ADR-0001: в модулях domain и application не должно быть
                                            ни Spring, ни JPA, ни Hibernate — ни прямо, ни транзитивно.
                                            Фреймворк живёт в адаптерах и в archi-bootstrap.
                                        </message>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
