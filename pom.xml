<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>uz.salvadore.hamkorbank</groupId>
    <artifactId>archi-creator</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Archi Creator</name>
    <description>
        Редактор архитектурных моделей ArchiMate. Раскладка модулей:
        слой и bounded context = модуль.
        Граница «домен не знает о фреймворке» держится сборкой: у доменных модулей
        нет ни Spring, ни JPA, поэтому нарушение не компилируется.
    </description>

    <modules>
        <module>archi-modeling</module>
        <module>archi-interchange</module>
        <module>archi-advisor</module>
        <module>archi-bootstrap</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
            Время файлов в jar и время сборки в build-info: с ним один коммит даёт
            одни байты jar. Меняется вместе с версией проекта.
        -->
        <project.build.outputTimestamp>2026-10-22T00:00:00Z</project.build.outputTimestamp>

        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- Поверх BOM Spring Boot, см. dependencyManagement. -->
        <jackson.version>3.1.8</jackson.version>
        <jackson-2.version>2.21.8</jackson-2.version>
        <tomcat.version>11.0.27</tomcat.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <!--
            Юнит-тесты и интеграционные (*IT, Testcontainers) в CI идут разными шагами:
            шаг интеграционных выключает юнит-тесты (-DskipUnitTests), итоговый verify —
            интеграционные (-DskipITs). Локально `mvn verify` гоняет и те и другие.
        -->
        <skipUnitTests>false</skipUnitTests>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <!-- Запрет фреймворка выключен; модули domain и application ставят validate. -->
        <ban-framework.phase>none</ban-framework.phase>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <archunit.version>1.5.1</archunit.version>
        <anthropic-java.version>2.71.0</anthropic-java.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <batik.version>1.19</batik.version>
        <fontbox.version>3.0.8</fontbox.version>
        <jgit.version>7.8.0.202609011348-r</jgit.version>
        <java-uuid-generator.version>5.2.0</java-uuid-generator.version>
        <error-prone.version>2.51.0</error-prone.version>
        <nullaway.version>0.14.2</nullaway.version>
        <!--
            Пакеты, которые NullAway проверяет: весь код проекта, кроме перечисленных
            в nullaway.unannotated (через запятую; пусто — проверяется всё).
        -->
        <nullaway.annotated>uz.salvadore.hamkorbank.archi</nullaway.annotated>
        <nullaway.unannotated>uz.salvadore.hamkorbank.archi.modeling,uz.salvadore.hamkorbank.archi.interchange,uz.salvadore.hamkorbank.archi.advisor,uz.salvadore.hamkorbank.archi.bootstrap</nullaway.unannotated>
        <depgraph-maven-plugin.version>4.0.5</depgraph-maven-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.3.0</checkstyle.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <pmd.version>7.28.0</pmd.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <maven-artifact-plugin.version>3.7.0</maven-artifact-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>

        <!--
            Node и npm ставит сборка, а не разработчик: иначе версия
            зависит от машины, а фронтенд собирается по-разному в CI
            и локально. v24 — действующий LTS.
        -->
        <node.version>v24.21.0</node.version>
        <npm.version>11.19.0</npm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Версии с исправлениями уязвимостей поверх BOM Spring Boot: в нём Tomcat
                и Jackson с CVE уровня HIGH и CRITICAL, а выпуска Boot новее нет. Импорт,
                объявленный раньше, сильнее импорта BOM, явная версия — сильнее обоих.
                Выйдет Boot с этими версиями или новее — блок удаляется; держит шаг
                Trivy в CI.
            -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <!--
                Импорт BOM фиксирует версии, но не добавляет ничего на classpath:
                доменные модули остаются чистыми, версии Spring, Flyway, драйвера
                PostgreSQL и JUnit в модулях не пинятся.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                ArchUnit держит то, что сборкой не держится: изоляцию контекстов
                друг от друга. Версия здесь, подключение — в archi-bootstrap.
            -->
            <!--
                Аннотации JetBrains приходят дважды: 13.0 — от kotlin-stdlib клиента Anthropic,
                17.0.0 — от duct-tape в Testcontainers. Это метаданные компиляции, на работу
                не влияют; версия закреплена старшая — иначе сходимость версий роняет сборку.
            -->
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>17.0.0</version>
            </dependency>
            <!-- Клиент Anthropic API — только в archi-bootstrap, за портом LlmPort помощника. -->
            <dependency>
                <groupId>com.anthropic</groupId>
                <artifactId>anthropic-java</artifactId>
                <version>${anthropic-java.version}</version>
            </dependency>
            <!--
                Предохранитель на Anthropic API: во Spring Framework 7 своего нет. Модуль метрик
                тянет все модули Resilience4j — оставлен только предохранитель.
            -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.github.resilience4j</groupId>
                        <artifactId>resilience4j-bulkhead</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.github.resilience4j</groupId>
                        <artifactId>resilience4j-retry</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.github.resilience4j</groupId>
                        <artifactId>resilience4j-ratelimiter</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.github.resilience4j</groupId>
                        <artifactId>resilience4j-timelimiter</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!--
                UUID проекта создаются и разбираются только этой библиотекой. Объявленный
                ею slf4j-api исключён: генератор версии 7 и разбор строки логгер не трогают,
                а доменным модулям он не нужен.
            -->
            <dependency>
                <groupId>com.fasterxml.uuid</groupId>
                <artifactId>java-uuid-generator</artifactId>
                <version>${java-uuid-generator.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-api</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!--
                commons-io приходит двумя версиями: 2.17.0 от xmlgraphics-commons (Batik)
                и 2.20.0 от commons-compress (Testcontainers). Ближе к корню старшая не
                оказывается, поэтому версия закреплена здесь — новая из двух, совместима
                с обеими; без неё сходимость версий роняет сборку.
            -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.20.0</version>
            </dependency>
            <!-- Растр и шрифт экспорта картинок — только в archi-bootstrap, за портами Rasterizer и Typesetter. -->
            <dependency>
                <groupId>org.apache.xmlgraphics</groupId>
                <artifactId>batik-transcoder</artifactId>
                <version>${batik.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.xmlgraphics</groupId>
                <artifactId>batik-codec</artifactId>
                <version>${batik.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>fontbox</artifactId>
                <version>${fontbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-modeling-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-interchange-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>archi-advisor-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            Аннотации null-безопасности во всех модулях, домен включительно: только аннотации,
            без кода и без своих зависимостей. Пакет размечен @NullMarked — всё не-null,
            отсутствие значения помечается @Nullable; проверяет NullAway при компиляции.
        -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- Тестовый стек доступен всем модулям; Spring сюда не попадает. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- Имена параметров в байткоде: по ним Spring связывает @PathVariable
                             и @RequestParam. Родитель spring-boot-starter-parent включал бы это
                             сам, но проект его не наследует. -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${error-prone.version}</version>
                            </path>
                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                    <executions>
                        <!--
                            NullAway — только в основном коде, нарушение роняет компиляцию.
                            Остальные проверки Error Prone выключены: их держат PMD и SpotBugs.
                            Тесты не проверяются — они делят пакеты с основным кодом, а null
                            в тесте — способ проверить отказ.
                        -->
                        <execution>
                            <id>default-compile</id>
                            <configuration>
                                <compilerArgs>
                                    <arg>-XDcompilePolicy=simple</arg>
                                    <arg>--should-stop=ifError=FLOW</arg>
                                    <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=${nullaway.annotated} -XepOpt:NullAway:UnannotatedSubPackages=${nullaway.unannotated} -XepExcludedPaths:.*/target/generated-sources/.*</arg>
                                </compilerArgs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <skipTests>${skipUnitTests}</skipTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>

                <!--
                    Граф зависимостей (https://github.com/ferstl/depgraph-maven-plugin).
                    К жизненному циклу не привязан: сборка от него не зависит, а лишний
                    прогон на каждом mvn package стоил бы секунд без причины. Запускается
                    руками по закрытии этапа — tools/render-depgraph.py.

                    Здесь общая часть настроек: формат PlantUML и версии на узлах.
                    Флаги showDuplicates и showConflicts сюда НЕ вынесены — их понимает
                    только цель graph, а цель aggregate на них падает: «Cannot find
                    'showDuplicates'». Они живут в скрипте, рядом с той целью,
                    которой принадлежат.
                -->
                <plugin>
                    <groupId>com.github.ferstl</groupId>
                    <artifactId>depgraph-maven-plugin</artifactId>
                    <version>${depgraph-maven-plugin.version}</version>
                    <configuration>
                        <graphFormat>puml</graphFormat>
                        <showVersions>true</showVersions>
                        <outputDirectory>${session.executionRootDirectory}/docs/dependencies</outputDirectory>
                    </configuration>
                </plugin>

                <!--
                    Граница домена держится сборкой. Отсутствия зависимости
                    достаточно, пока её никто не вернул, — это правило останавливает
                    возврат. Плагин подключён во всех модулях (build/plugins ниже),
                    а запрет фреймворка включается свойством ban-framework.phase=validate
                    только в модулях domain и application: адаптерам Spring нужен.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>ban-framework</id>
                            <phase>${ban-framework.phase}</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <bannedDependencies>
                                        <searchTransitive>true</searchTransitive>
                                        <excludes>
                                            <exclude>org.springframework*:*</exclude>
                                            <exclude>jakarta.persistence:*</exclude>
                                            <exclude>jakarta.transaction:*</exclude>
                                            <exclude>org.hibernate*:*</exclude>
                                            <exclude>com.fasterxml.jackson*:*</exclude>
                                            <exclude>tools.jackson*:*</exclude>
                                        </excludes>
                                        <message>
                                            ADR-0001: в модулях domain и application не должно быть
                                            ни Spring, ни JPA, ни Hibernate, ни Jackson — ни прямо, ни транзитивно.
                                            Фреймворк и разбор JSON живут в адаптерах и в archi-bootstrap.
                                        </message>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Правила сборки всех модулей: одна версия каждой библиотеки в дереве
                модуля, Maven и JDK не старше тех, на которых проект собирается.
                Расхождение версий иначе видно только на графе зависимостей.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                </requireJavaVersion>
                                <!--
                                    Стартеры под именами Spring Boot 3: в 4.x это устаревшие псевдонимы
                                    новых (webmvc, aspectj, webservices, security-oauth2-*).
                                -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-aop</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-web-services</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-resource-server</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-oauth2-client</exclude>
                                    </excludes>
                                    <message>Стартер Spring Boot 3 — нужно имя Spring Boot 4.</message>
                                </bannedDependencies>
                                <!-- Тестовый classpath — тоже: тесты идут на нём. -->
                                <dependencyConvergence>
                                    <excludedScopes>
                                        <scope>provided</scope>
                                    </excludedScopes>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Длина строки и табуляция — для основного кода и тестов всех модулей.
                Фаза validate: нарушение видно раньше компиляции и тестов.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>format</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Покрытие: агент JaCoCo на юнит-тестах (jacoco.exec) и интеграционных
                (jacoco-it.exec) каждого модуля; общий отчёт собирает archi-bootstrap.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>agent-it</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Воспроизводимость: время сборки задано, и плагины плана сборки — версий,
                которые его соблюдают. Иначе два прогона одного коммита дают разные jar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-artifact-plugin</artifactId>
                <version>${maven-artifact-plugin.version}</version>
                <executions>
                    <execution>
                        <id>reproducible</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check-buildplan</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Статический анализ байткода основного кода: ошибки высокой уверенности
                роняют сборку сразу после компиляции, раньше тестов.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <threshold>High</threshold>
                    <failThreshold>High</failThreshold>
                </configuration>
                <executions>
                    <execution>
                        <id>bugs</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Сложность метода, пустой catch, вывод в консоль — для основного кода и тестов.
                PMD разбирает типы по скомпилированным классам, поэтому фаза — после компиляции
                тестов: нарушение роняет и `test`, и `package`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/config/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <includeTests>true</includeTests>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>rules</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
