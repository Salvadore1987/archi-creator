# ───────────────────────────────────────────────────────────────────
# Образец окружения. Скопировать в .env и заполнить:
#
#   cp .env.example .env
#
# .env в репозиторий не попадает (см. .gitignore): ключ
# Anthropic, пароль БД и client secret Keycloak живут только на сервере.
# Значения ниже — заглушки, а не рабочие секреты.
#
# Файл читают двое: docker-compose.yml (переменные подставляются
# в сервисы) и приложение, запущенное локально (переменные окружения
# берут верх над умолчаниями в application.yaml).
# ───────────────────────────────────────────────────────────────────

# ── База данных ────────────────────────────────────────────────────
POSTGRES_DB=archi
POSTGRES_USER=archi
POSTGRES_PASSWORD=change-me

# То же самое глазами приложения. Хост postgres — имя сервиса в compose;
# при локальном запуске без Docker заменить на localhost.
ARCHI_DB_URL=jdbc:postgresql://postgres:5432/archi
ARCHI_DB_USER=archi
ARCHI_DB_PASSWORD=change-me

# ── Keycloak ───────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Issuer виден и приложению, и браузеру, поэтому адрес внешний,
# а не имя сервиса: по нему фронтенд уходит на страницу логина.
ARCHI_OIDC_ISSUER_URI=http://localhost:8081/realms/archi

# Адрес realm'а, на который фронтенд ведёт браузер (GET /api/v1/ui-config).
# Не задан — берётся ARCHI_OIDC_ISSUER_URI.
ARCHI_OIDC_PUBLIC_ISSUER_URI=http://localhost:8081/realms/archi

# ── ИИ ─────────────────────────────────────────────────────────────
# Пустое значение допустимо: приложение стартует с выключенным ИИ.
# Ключ не покидает сервер и в браузер не отдаётся.
ANTHROPIC_API_KEY=

# ── Git ────────────────────────────────────────────────────────────
# Токен доступа к репозиторию рабочего пространства (GitLab: Project Access
# Token с правом write_repository). Администратор указывает в привязке
# не сам токен, а ссылку env:ARCHI_GIT_TOKEN. Пусто — выгрузка в Git ждёт.
ARCHI_GIT_TOKEN=
# Коммитер — сервер; автор коммита — архитектор, сохранивший версию.
ARCHI_GIT_COMMITTER_NAME=Archi Creator
ARCHI_GIT_COMMITTER_EMAIL=archi-creator@bank.uz

# ── Профиль ────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
