# ───────────────────────────────────────────────────────────────────
# Образец .gitlab-ci.yml для репозитория выгрузки рабочего пространства.
#
# Сгенерированный .archimate в репозиторий не кладётся: он производный и даёт
# шумный diff на каждое изменение. Вместо этого задача на теге берёт из
# помеченного коммита трейлеры Archi-Model-Id и Archi-Version и забирает
# файл версии у сервера — тот же, что отдаёт кнопка «Экспорт».
#
# Переменные CI/CD проекта (Settings → CI/CD → Variables, masked):
#   ARCHI_URL    адрес сервера, например https://archi.bank.uz
#   ARCHI_TOKEN  токен доступа роли VIEWER (сервисная учётная запись Keycloak)
#
# Тег ставится на коммит версии: каждый коммит сервера относится к одной
# модели — той, что в трейлере.
# ───────────────────────────────────────────────────────────────────

archimate:
  stage: deploy
  image: alpine:3.20
  rules:
    - if: $CI_COMMIT_TAG
  variables:
    GIT_DEPTH: "1"
  script:
    - apk add --no-cache git curl
    - MODEL_ID=$(git log -1 --format='%(trailers:key=Archi-Model-Id,valueonly)' "$CI_COMMIT_SHA" | tr -d '[:space:]')
    - VERSION=$(git log -1 --format='%(trailers:key=Archi-Version,valueonly)' "$CI_COMMIT_SHA" | tr -d '[:space:]')
    - test -n "$MODEL_ID" && test -n "$VERSION"
    - >
      curl --fail --silent --show-error
      --header "Authorization: Bearer ${ARCHI_TOKEN}"
      --output "${CI_COMMIT_TAG}.archimate"
      "${ARCHI_URL}/api/v1/models/${MODEL_ID}/export?version=${VERSION}"
  artifacts:
    name: "$CI_COMMIT_TAG"
    paths:
      - "*.archimate"
    expire_in: never
