<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Форматирование, которое держит сборка: длина строки, табуляция и перевод строки — по тексту
    файла; скобки, отступ, пробелы, импорты и Javadoc — по дереву разбора.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!--
        Строка разметки XML в текстовом блоке — эталонные данные в раскладке Archi,
        где элемент пишется одной строкой: перенос изменил бы сам эталон.
    -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^\s*(&lt;[A-Za-z/!?]|xmlns:)"/>
    </module>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <!-- Перевод строки — LF, в конце файла он есть, пробелов в конце строки нет: как в .editorconfig. -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>
    <module name="RegexpMultiline">
        <property name="id" value="CarriageReturn"/>
        <property name="format" value="\r"/>
        <property name="message" value="Перевод строки CRLF: файл хранится с LF"/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="TrailingWhitespace"/>
        <property name="format" value="\s+$"/>
        <property name="message" value="Пробел в конце строки"/>
    </module>

    <!-- Javadoc обязателен в основном коде; тесты читаются по @DisplayName. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MissingJavadocType|MissingJavadocMethod|JavadocVariable"/>
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
    </module>

    <module name="TreeWalker">
        <!-- Скобки всегда и в египетском стиле; блок — 4 пробела, продолжение строки — 8. -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="caseIndent" value="4"/>
            <property name="arrayInitIndent" value="4"/>
            <property name="lineWrappingIndentation" value="8"/>
            <property name="throwsIndent" value="8"/>
        </module>
        <!-- Пробелы вокруг операторов, после запятой и ключевого слова; нет пробела перед скобкой параметров. -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>

        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <!-- Статические импорты первым блоком, пустая строка, остальные одним блоком по алфавиту. -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules" value="STATIC###THIRD_PARTY_PACKAGE"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <!--
            Javadoc у публичных типов, публичных и protected методов и публичных констант.
            Метод с @Override описан в объявлении, которое он реализует.
        -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="protected"/>
            <property name="allowMissingPropertyJavadoc" value="false"/>
            <property name="tokens" value="METHOD_DEF,ANNOTATION_FIELD_DEF"/>
        </module>
        <!-- Javadoc стоит прямо перед объявлением: осиротевший блок описывает не тот метод. -->
        <module name="InvalidJavadocPosition"/>
        <module name="JavadocVariable">
            <property name="accessModifiers" value="public"/>
            <property name="tokens" value="VARIABLE_DEF"/>
        </module>
        <!-- Публичное поле, а не константа: поле JPA-сущности, его описывает столбец. -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="JavadocVariable"/>
            <property name="query" value="//VARIABLE_DEF[not(./MODIFIERS/LITERAL_STATIC and ./MODIFIERS/FINAL)]"/>
        </module>
    </module>
</module>
