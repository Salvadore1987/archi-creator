<?xml version="1.0"?>
<!--
    Правила PMD, которые держит сборка: сложность метода, пустой и общий catch, var, вывод в консоль,
    закрытие ресурсов и сравнение объектов.
    Основной код и тесты всех модулей.
-->
<ruleset name="archi-creator"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Правила стиля и сложности, проверяемые на сборке.</description>

    <!-- Предел сложности метода — 25; сложность класса не ограничивается. -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="26"/>
            <property name="classReportLevel" value="100000"/>
        </properties>
    </rule>

    <!-- Ошибка не исчезает молча: пустой catch запрещён и с комментарием. -->
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowCommentedBlocks" value="false"/>
        </properties>
    </rule>

    <!--
        Ловится то, что код умеет обработать: исключение разбора значения, отказ контекста.
        NullPointerException, RuntimeException, Exception, Throwable и Error не ловятся —
        перехват выдаёт будущую ошибку программы за ожидаемый отказ.
    -->
    <rule ref="category/java/errorprone.xml/AvoidCatchingGenericException"/>

    <!-- Тип переменной виден в диффе: var запрещён. -->
    <rule ref="category/java/codestyle.xml/UseExplicitTypes"/>

    <rule ref="category/java/bestpractices.xml/SystemPrintln"/>
    <rule ref="category/java/bestpractices.xml/AvoidPrintStackTrace"/>
    <!-- Ресурс закрывается try-with-resources: ручное закрытие пропускают отказ и ранний выход. -->
    <rule ref="category/java/errorprone.xml/CloseResource"/>
    <!-- Объекты сравниваются equals; сравнение ссылок — намеренное, с NOPMD и причиной. -->
    <rule ref="category/java/errorprone.xml/CompareObjectsWithEquals"/>
</ruleset>
